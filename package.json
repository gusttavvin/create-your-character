{
  "name": "create-your-character",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Create Your Character — a kid-friendly English learning game (monster, dragon, princess) in 2D and 3D",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "models:monster": "node art-source/approved/model-library.mjs",
    "memory:index": "node scripts/memory-emoji-index.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.116.0",
    "react": "19.2",
    "react-dom": "19.2",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xmldom/xmldom": "^0.9.12",
    "gltf-validator": "^2.0.0-dev.3.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
